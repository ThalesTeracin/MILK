MILK_NAME=MILK
MILK_LANGUAGE=pt-BR

MILK_VOICE=pt-BR-FranciscaNeural
MILK_VOICE_RATE=+0%
MILK_VOICE_VOLUME=+0%

# Cadeia de provedores (src/ai/router.py).
# AI_PROVIDER_ORDER e a ordem de tentativa: o primeiro responde, e quem
# estiver fora do ar passa a vez para o proximo. Provedor sem chave, sem
# URL ou sem modelo fica fora da cadeia. Enderecos e modelos padrao
# ficam em config/providers.json; as variaveis abaixo sobrepoem.
AI_PROVIDER_ORDER=9router_custom,omniroute,freellmapi,openrouter_free,groq,gemini,nvidia

# 9Router / gateway local (padrao: http://localhost:20128/v1)
NINEROUTER_BASE_URL=
NINEROUTER_MODEL=
NINEROUTER_API_KEY=

# OmniRoute -- gateway local, porta padrao 20128, a MESMA do 9Router.
# Rodando os dois na mesma maquina, mude a porta de um aqui.
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=

# FreeLLMAPI -- gateway local que empilha camadas gratuitas, porta
# padrao 3001. E a reserva para quando as contas pagas estiverem
# indisponiveis. Nome do modelo: consulte GET /v1/models.
FREELLMAPI_BASE_URL=
FREELLMAPI_MODEL=
FREELLMAPI_API_KEY=

# Provedores diretos (URL e modelo ja vem de config/providers.json)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

AI_MAX_TOKENS=900
AI_TIMEOUT_SECONDS=35

MILK_PROJECTS_DIR=C:\JARVIS\projects
MILK_SCREENSHOTS_DIR=C:\JARVIS\screenshots
MILK_BROWSER_PROFILE=C:\JARVIS\browser_profile

MILK_VISION_ENABLED=true
MILK_BROWSER_ENABLED=true
MILK_BROWSER_HEADLESS=false
MILK_REQUIRE_CONFIRM_FOR_SUBMIT=true
MILK_REQUIRE_CONFIRM_FOR_DOWNLOAD=true
